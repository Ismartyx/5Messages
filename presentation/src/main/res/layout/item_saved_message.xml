<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/cardLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_rectangle_16dp"
        android:backgroundTint="?attr/bubbleColor"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <com.goodwy.messages.common.widget.TightTextView
            android:id="@+id/messageText"
            style="@style/TextPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            android:textIsSelectable="true"
            android:textSize="15sp"
            tools:text="یادداشت نمونه یا پیام ذخیره شده در برنامه" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:background="?android:attr/divider"
            android:alpha="0.25" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.goodwy.messages.common.widget.QkTextView
                android:id="@+id/messageDate"
                style="@style/TextTertiary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11.5sp"
                tools:text="1405/08/18 14:30" />

            <ImageView
                android:id="@+id/btnCopy"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/circle_ripple"
                android:padding="6dp"
                android:src="@drawable/ic_content_copy_black_24dp"
                android:tint="?android:attr/textColorSecondary"
                android:contentDescription="Copy" />

            <ImageView
                android:id="@+id/btnShare"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/circle_ripple"
                android:padding="6dp"
                android:src="@drawable/ic_share_black_24dp"
                android:tint="?android:attr/textColorSecondary"
                android:contentDescription="Share" />

            <ImageView
                android:id="@+id/btnDelete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/circle_ripple"
                android:padding="6dp"
                android:src="@drawable/ic_delete_white_24dp"
                android:tint="#EF4444"
                android:contentDescription="Delete" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
